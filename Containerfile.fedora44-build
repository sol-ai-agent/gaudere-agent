FROM registry.fedoraproject.org/fedora:44

RUN dnf install -y \
        autoconf \
        automake \
        diffutils \
        gcc-c++ \
        git \
        gzip \
        json-devel \
        libcurl-devel \
        libtool \
        make \
        pkgconf-pkg-config \
        python3 \
        sqlite-devel \
        tar \
        util-linux \
    && dnf clean all

WORKDIR /workspace/agent

# This image contains the Fedora 44 toolchain only. Project libraries are built
# into a workspace-local prefix by scripts/run-fedora44-build.sh; nothing from
# Gaudere is installed into /usr or /usr/local in this image or on the host.
CMD ["/bin/bash"]
